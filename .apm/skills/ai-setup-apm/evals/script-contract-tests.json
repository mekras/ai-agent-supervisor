{
  "version": 2,
  "operations": [
    {
      "id": "validate-git-boundary",
      "script": "scripts/validate-apm-git-boundary.py",
      "command_prefix": []
    }
  ],
  "cases": [
    {
      "id": "accept-empty-git-project",
      "script": "scripts/validate-apm-git-boundary.py",
      "fixture": "evals/script-fixtures/empty-project",
      "covers": ["validate-git-boundary"],
      "prepare": [["git", "init", "--quiet", "{fixture}"]],
      "command": ["{python}", "{script}", "{fixture}"],
      "expect": {
        "stdout_contains": ["Отслеживаемых Git проекций зависимостей APM не найдено."]
      }
    },
    {
      "id": "reject-missing-project",
      "script": "scripts/validate-apm-git-boundary.py",
      "fixture": "evals/script-fixtures/empty-project",
      "command": ["{python}", "{script}", "{fixture}/missing-project"],
      "expect": {
        "exit_code": 2,
        "stderr_contains": ["не найден каталог проекта"]
      }
    }
  ]
}
