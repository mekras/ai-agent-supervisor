#!/usr/bin/env python3
"""Create or update a minimal APM skill collection manifest."""

from __future__ import annotations

import argparse
from pathlib import Path

try:
    import yaml
except ImportError as error:
    raise SystemExit(
        "Для обновления apm.yml нужен PyYAML (pip install pyyaml).",
    ) from error


# Deterministic gate: structure validators only, no model or network calls.
DEFAULT_TESTS = (
    "sh -c 'set -e; target=\"${APM_EVAL_PATH:-.apm/skills}\"; "
    "python3 tools/validate-skill-descriptions.py \"$target\"; "
    "python3 tools/validate-trigger-evals.py \"$target\" --require-all; "
    "python3 tools/validate-skill-result-evals.py \"$target\"; "
    "python3 tools/validate-fixture-evals.py'"
)

# Optional model run kept out of the gate.
DEFAULT_EVALS = 'python3 tools/run-skill-evals.py "${APM_EVAL_PATH:-.apm/skills}"'


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Create or update apm.yml for a skills collection.",
    )
    parser.add_argument(
        "project_root",
        nargs="?",
        default=".",
        type=Path,
        help="Project root. Defaults to the current directory.",
    )
    parser.add_argument(
        "--name",
        help="Package name for a newly created manifest.",
    )
    parser.add_argument(
        "--description",
        default="Skill collection",
        help="Description for a newly created manifest.",
    )
    parser.add_argument(
        "--target",
        action="append",
        help="Target harness for a newly created manifest. May be repeated.",
    )
    parser.add_argument(
        "--skills-source",
        default=".apm/skills",
        help="Source directory for APM skills. Defaults to .apm/skills.",
    )
    parser.add_argument(
        "--test-command",
        help="Command stored in scripts.tests. Auto-detected when omitted.",
    )
    return parser.parse_args()


def detect_test_command(root: Path) -> str | None:
    required = [
        root / "tools" / "validate-skill-descriptions.py",
        root / "tools" / "validate-trigger-evals.py",
        root / "tools" / "validate-skill-result-evals.py",
    ]
    if all(path.is_file() for path in required):
        return DEFAULT_TESTS
    return None


def detect_evals_command(root: Path) -> str | None:
    if (root / "tools" / "run-skill-evals.py").is_file():
        return DEFAULT_EVALS
    return None


def ensure_source_tree(root: Path, skills_source: Path) -> None:
    source = skills_source if skills_source.is_absolute() else root / skills_source
    source.mkdir(parents=True, exist_ok=True)


class UniqueKeyLoader(yaml.SafeLoader):
    """Загрузчик YAML, который отклоняет повторяющиеся ключи отображения."""


def construct_unique_mapping(
    loader: yaml.SafeLoader,
    node: yaml.MappingNode,
    deep: bool = False,
) -> dict[object, object]:
    mapping: dict[object, object] = {}
    for key_node, value_node in node.value:
        key = loader.construct_object(key_node, deep=deep)
        if key in mapping:
            raise yaml.constructor.ConstructorError(
                "while constructing a mapping",
                node.start_mark,
                f"found duplicate key {key!r}",
                key_node.start_mark,
            )
        mapping[key] = loader.construct_object(value_node, deep=deep)
    return mapping


UniqueKeyLoader.add_constructor(
    yaml.resolver.BaseResolver.DEFAULT_MAPPING_TAG,
    construct_unique_mapping,
)


def mapping_field(manifest: dict[object, object], key: str) -> dict[object, object]:
    value = manifest.get(key)
    if value is None:
        value = {}
        manifest[key] = value
    if not isinstance(value, dict):
        raise SystemExit(f"apm.yml: поле {key} должно быть отображением YAML.")
    return value


def load_manifest(path: Path) -> dict[object, object]:
    try:
        data = yaml.load(path.read_text(encoding="utf-8"), Loader=UniqueKeyLoader)
    except yaml.YAMLError as error:
        raise SystemExit(f"Не удалось разобрать {path}: {error}") from error
    if not isinstance(data, dict):
        raise SystemExit(f"{path}: корень манифеста должен быть отображением YAML.")
    return data


def update_manifest(
    manifest: dict[object, object],
    targets: list[str],
    command: str,
    evals_command: str | None,
) -> dict[object, object]:
    scripts = mapping_field(manifest, "scripts")
    scripts["tests"] = command
    if evals_command:
        scripts["evals"] = evals_command

    manifest.setdefault("type", "skill")
    if "target" not in manifest and "targets" not in manifest:
        manifest["targets"] = targets
    manifest.setdefault("includes", "auto")

    dependencies = mapping_field(manifest, "dependencies")
    dependencies.setdefault("apm", [])
    dependencies.setdefault("mcp", [])
    return manifest


def create_manifest(
    root: Path,
    args: argparse.Namespace,
    command: str,
    evals_command: str | None,
) -> str:
    name = args.name or root.name
    targets = args.target or ["codex"]
    target_lines = "\n".join(f"  - {target}" for target in targets)
    scripts = f"scripts:\n  tests: {command!r}\n"
    if evals_command:
        scripts += f"  evals: {evals_command!r}\n"
    return (
        f"name: {name}\n"
        "version: 0.1.0\n"
        f'description: "{args.description}"\n'
        "targets:\n"
        f"{target_lines}\n"
        'type: "skill"\n'
        "includes: auto\n"
        "dependencies:\n"
        "  apm: []\n"
        "  mcp: []\n"
        f"{scripts}"
    )


def uses_claude_target(targets: list[str]) -> bool:
    return any(target.strip().lower() == "claude" for target in targets)


def main() -> int:
    args = parse_args()
    root = args.project_root.resolve()
    manifest = root / "apm.yml"
    targets = args.target or ["codex"]
    command = args.test_command or detect_test_command(root)
    if not command:
        raise SystemExit(
            "No test command detected. Pass --test-command or create collection tests first.",
        )
    evals_command = detect_evals_command(root)
    ensure_source_tree(root, Path(args.skills_source))

    if manifest.exists():
        data = update_manifest(load_manifest(manifest), targets, command, evals_command)
        text = yaml.safe_dump(data, allow_unicode=True, sort_keys=False)
    else:
        text = create_manifest(root, args, command, evals_command)

    manifest.write_text(text, encoding="utf-8")
    print(f"manifest={manifest}")
    print(f"skills_source={(root / args.skills_source).resolve()}")
    print(f"tests={command}")
    if evals_command:
        print(f"evals={evals_command}")
    if uses_claude_target(targets):
        print(
            "note=targets include claude; client setup should check CLAUDE.md and prefer @AGENTS.md or a symlink to AGENTS.md",
        )
    if (root / "skills").exists() and not any((root / ".apm" / "skills").iterdir()):
        print("warning=root skills/ exists, but .apm/skills is empty")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
